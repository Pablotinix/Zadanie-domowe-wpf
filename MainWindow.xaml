<Window x:Class="Zadanie_domowee.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zadanie_domowee"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="7,5,-7,-5">
        <Image HorizontalAlignment="Left" Height="474" Margin="-7,-5,0,0" VerticalAlignment="Top" Width="797" Source="/1 (1).jpg"/>

        <Button x:Name="Przycisk" Content="Kliknij mnie" HorizontalAlignment="Left" Height="70" Margin="331,317,0,0" VerticalAlignment="Top" Width="112" Click="Przycisk_Click"/>
        <DataGrid x:Name="Lista_Magazynowa" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="300,34,25,275" AutoGenerateColumns="False" SelectionChanged="DataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="id" Binding="{Binding id}"/>
                <DataGridTextColumn CanUserResize="True" Header="Ean" Binding="{Binding Ean}"/>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}"/>
                <DataGridTextColumn Header="Ilosc" Binding="{Binding Ilosc}"/>
                <DataGridTextColumn Header="Kategoria" Binding="{Binding Kategoria}"/>
                <DataGridTextColumn Header="Lokalizacja" Binding="{Binding Lokalizacja}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBox x:Name="WpisanieNazwy" HorizontalAlignment="Left" Height="45" Margin="30,102,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="95" TextChanged="TextBox_TextChanged" Background="Black" Foreground="White"/>
        <TextBox x:Name="WpisanieEan" HorizontalAlignment="Left" Height="43" Margin="30,34,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="95" Foreground="White" Background="Black"/>
        <TextBox x:Name="WpisanieKategori" HorizontalAlignment="Left" Height="47" Margin="30,237,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="95" TextChanged="WpisanieKategori_TextChanged" Background="Black" Foreground="White"/>
        <TextBox x:Name="WpisanieLokalizacji" HorizontalAlignment="Left" Height="46" Margin="30,329,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="95" TextChanged="WpisanieLokalizacji_TextChanged" Background="Black" Foreground="White"/>
        <Slider x:Name="WpisanieIlosci" HorizontalAlignment="Left" Height="34" Margin="30,178,0,0" VerticalAlignment="Top" Width="471" Maximum="100" ValueChanged="WpisanieIlosci_ValueChanged" Minimum="1" AutoToolTipPlacement="BottomRight" Value="1" />
        <TextBlock HorizontalAlignment="Left" Height="19" Margin="30,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="74"><Run Language="pl-pl" Text="Wpisz Ean"/><LineBreak/><Run Language="pl-pl"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Height="15" Margin="30,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="95"><Run Language="pl-pl" Text="Wpisz Nazwe"/><LineBreak/><Run Language="pl-pl"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Height="14" Margin="30,152,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="74"><Run Language="pl-pl" Text="Wybierz ilosc"/></TextBlock>
        <TextBox HorizontalAlignment="Left" Height="20" Margin="30,217,0,0" TextWrapping="Wrap" Text="Wpisz kategorie&#xA;" VerticalAlignment="Top" Width="95"/>
        <TextBlock HorizontalAlignment="Left" Height="37" Margin="30,284,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="74"><Run Text="Wpisz"/><Run Language="pl-pl" Text=" "/><Run Text="lokalizacje"/><LineBreak/><Run/></TextBlock>

    </Grid>
</Window>
